
import sys
import os
import uuid
import html
import tempfile
import zipfile
from pathlib import Path
from datetime import datetime, timezone
from xml.etree import ElementTree as ET

import fitz  # PyMuPDF
from PySide6.QtCore import QThread, Signal
from PySide6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QLabel, QPushButton,
    QFileDialog, QVBoxLayout, QHBoxLayout, QComboBox,
    QProgressBar, QMessageBox
)


def convert_pdf_to_epub(pdf_path, epub_path, dpi, progress):
    book_id = str(uuid.uuid4())
    title = Path(pdf_path).stem
    safe_title = html.escape(title, quote=True)

    with fitz.open(pdf_path) as pdf:
        if pdf.needs_pass:
            raise ValueError("This PDF is password-protected.")
        if pdf.page_count == 0:
            raise ValueError("The PDF contains no pages.")

        with tempfile.TemporaryDirectory() as temp:
            root = Path(temp)
            epub_dir = root / "EPUB"
            images_dir = epub_dir / "images"
            text_dir = epub_dir / "text"
            meta_dir = root / "META-INF"

            images_dir.mkdir(parents=True)
            text_dir.mkdir()
            meta_dir.mkdir()

            page_items = []
            toc_items = []

            for index, page in enumerate(pdf, start=1):
                filename = f"page{index:04d}"
                image_name = filename + ".jpg"
                xhtml_name = filename + ".xhtml"

                pix = page.get_pixmap(
                    matrix=fitz.Matrix(dpi / 72, dpi / 72),
                    colorspace=fitz.csRGB,
                    alpha=False
                )
                pix.save(
                    str(images_dir / image_name),
                    jpg_quality=94
                )

                # Keep the original page's proportions.
                width = max(1, round(page.rect.width))
                height = max(1, round(page.rect.height))

                page_xhtml = f'''<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:epub="http://www.idpf.org/2007/ops">
<head>
  <title>Page {index}</title>
  <meta name="viewport"
        content="width={width}, height={height}"/>
  <style>
    html, body {{
      margin: 0; padding: 0;
      width: 100%; height: 100%;
      overflow: hidden;
    }}
    img {{
      display: block;
      width: 100%; height: 100%;
      object-fit: contain;
    }}
  </style>
</head>
<body>
  <img src="../images/{image_name}"
       alt="Page {index} of {safe_title}"/>
</body>
</html>'''

                (text_dir / xhtml_name).write_text(
                    page_xhtml, encoding="utf-8"
                )

                page_items.append(
                    (filename, image_name, xhtml_name, index == 1)
                )
                toc_items.append(
                    f'<li><a href="text/{xhtml_name}">'
                    f'Page {index}</a></li>'
                )

                progress(
                    int(index * 90 / pdf.page_count),
                    f"Rendering page {index} of {pdf.page_count}"
                )

            nav = f'''<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:epub="http://www.idpf.org/2007/ops">
<head><title>Contents</title></head>
<body>
  <nav epub:type="toc" id="toc">
    <h1>Contents</h1>
    <ol>{"".join(toc_items)}</ol>
  </nav>
</body>
</html>'''
            (epub_dir / "nav.xhtml").write_text(
                nav, encoding="utf-8"
            )

            modified = datetime.now(timezone.utc).strftime(
                "%Y-%m-%dT%H:%M:%SZ"
            )

            manifest = [
                '<item id="nav" href="nav.xhtml" '
                'media-type="application/xhtml+xml" properties="nav"/>'
            ]
            spine = []

            for file_id, image_name, xhtml_name, is_cover in page_items:
                cover_property = (
                    ' properties="cover-image"' if is_cover else ""
                )
                manifest.append(
                    f'<item id="{file_id}-img" '
                    f'href="images/{image_name}" '
                    f'media-type="image/jpeg"{cover_property}/>'
                )
                manifest.append(
                    f'<item id="{file_id}" '
                    f'href="text/{xhtml_name}" '
                    'media-type="application/xhtml+xml"/>'
                )
                spine.append(f'<itemref idref="{file_id}"/>')

            opf = f'''<?xml version="1.0" encoding="UTF-8"?>
<package xmlns="http://www.idpf.org/2007/opf"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         version="3.0" unique-identifier="bookid"
         prefix="rendition: http://www.idpf.org/vocab/rendition/#">
  <metadata>
    <dc:identifier id="bookid">urn:uuid:{book_id}</dc:identifier>
    <dc:title>{safe_title}</dc:title>
    <dc:language>en</dc:language>
    <meta property="dcterms:modified">{modified}</meta>
    <meta property="rendition:layout">pre-paginated</meta>
    <meta property="rendition:spread">auto</meta>
    <meta property="rendition:orientation">auto</meta>
  </metadata>
  <manifest>
    {"".join(manifest)}
  </manifest>
  <spine page-progression-direction="ltr">
    {"".join(spine)}
  </spine>
</package>'''

            (epub_dir / "content.opf").write_text(
                opf, encoding="utf-8"
            )

            container = '''<?xml version="1.0" encoding="UTF-8"?>
<container version="1.0"
 xmlns="urn:oasis:names:tc:opendocument:xmlns:container">
  <rootfiles>
    <rootfile full-path="EPUB/content.opf"
     media-type="application/oebps-package+xml"/>
  </rootfiles>
</container>'''
            (meta_dir / "container.xml").write_text(
                container, encoding="utf-8"
            )

            progress(95, "Packaging EPUB...")

            # EPUB requires the mimetype file first and uncompressed.
            with zipfile.ZipFile(epub_path, "w") as archive:
                archive.writestr(
                    "mimetype",
                    "application/epub+zip",
                    compress_type=zipfile.ZIP_STORED
                )
                for folder in (meta_dir, epub_dir):
                    for file in folder.rglob("*"):
                        if file.is_file():
                            archive.write(
                                file,
                                file.relative_to(root).as_posix(),
                                compress_type=zipfile.ZIP_DEFLATED
                            )

            progress(100, "Conversion complete")


class Worker(QThread):
    progress_changed = Signal(int, str)
    succeeded = Signal(str)
    failed = Signal(str)

    def __init__(self, source, destination, dpi):
        super().__init__()
        self.source = source
        self.destination = destination
        self.dpi = dpi

    def run(self):
        try:
            convert_pdf_to_epub(
                self.source,
                self.destination,
                self.dpi,
                lambda value, message:
                    self.progress_changed.emit(value, message)
            )
            self.succeeded.emit(self.destination)
        except Exception as exc:
            self.failed.emit(str(exc))


class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("PDF to EPUB Converter")
        self.resize(600, 360)
        self.source = ""
        self.worker = None

        central = QWidget()
        layout = QVBoxLayout(central)
        layout.setSpacing(14)

        heading = QLabel("PDF to Image-Based EPUB")
        heading.setStyleSheet("font-size: 22px; font-weight: bold;")
        layout.addWidget(heading)

        layout.addWidget(QLabel(
            "Preserve the original page appearance and item order."
        ))

        file_row = QHBoxLayout()
        self.file_label = QLabel("No PDF selected")
        self.file_label.setWordWrap(True)
        choose = QPushButton("Choose PDF...")
        choose.clicked.connect(self.choose_pdf)
        file_row.addWidget(self.file_label, 1)
        file_row.addWidget(choose)
        layout.addLayout(file_row)

        layout.addWidget(QLabel("Image quality:"))
        self.quality = QComboBox()
        self.quality.addItem("150 DPI — smaller file", 150)
        self.quality.addItem("200 DPI — recommended", 200)
        self.quality.addItem("300 DPI — high detail", 300)
        self.quality.setCurrentIndex(1)
        layout.addWidget(self.quality)

        self.convert_button = QPushButton("Convert to EPUB")
        self.convert_button.setMinimumHeight(42)
        self.convert_button.clicked.connect(self.convert)
        layout.addWidget(self.convert_button)

        self.progress = QProgressBar()
        self.progress.setValue(0)
        layout.addWidget(self.progress)

        self.status = QLabel("Ready")
        layout.addWidget(self.status)

        layout.addStretch()
        self.setCentralWidget(central)

    def choose_pdf(self):
        path, _ = QFileDialog.getOpenFileName(
            self, "Select PDF", "", "PDF files (*.pdf)"
        )
        if path:
            self.source = path
            self.file_label.setText(path)
            self.status.setText("PDF selected")

    def convert(self):
        if not self.source:
            QMessageBox.information(
                self, "Select a PDF", "Choose a PDF file first."
            )
            return

        suggested = str(Path(self.source).with_suffix(".epub"))
        destination, _ = QFileDialog.getSaveFileName(
            self, "Save EPUB", suggested, "EPUB files (*.epub)"
        )
        if not destination:
            return
        if not destination.lower().endswith(".epub"):
            destination += ".epub"

        if os.path.abspath(destination) == os.path.abspath(self.source):
            QMessageBox.warning(
                self, "Invalid destination",
                "Choose a different output file."
            )
            return

        self.convert_button.setEnabled(False)
        self.progress.setValue(0)

        self.worker = Worker(
            self.source, destination, self.quality.currentData()
        )
        self.worker.progress_changed.connect(self.update_progress)
        self.worker.succeeded.connect(self.done)
        self.worker.failed.connect(self.error)
        self.worker.start()

    def update_progress(self, value, message):
        self.progress.setValue(value)
        self.status.setText(message)

    def done(self, path):
        self.convert_button.setEnabled(True)
        self.status.setText("Conversion complete")
        QMessageBox.information(
            self, "Success", f"EPUB saved to:\n{path}"
        )

    def error(self, message):
        self.convert_button.setEnabled(True)
        self.status.setText("Conversion failed")
        QMessageBox.critical(self, "Conversion error", message)


app = QApplication(sys.argv)
window = MainWindow()
window.show()
sys.exit(app.exec())
